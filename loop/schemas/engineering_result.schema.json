{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "files_changed",
    "tests_run",
    "known_risks",
    "needs_human"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "implemented",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needs_human": {
      "type": "boolean"
    }
  }
}
