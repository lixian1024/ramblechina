NEXT_PUBLIC_APP_URL=http://localhost:3000
# GA4 web stream Measurement ID (G-...), public, not a Google Maps/API key.
# Production only; unset uses the site default. Explicit blank disables it.
# Rebuild/redeploy after changing.
# Before enabling: disable Enhanced Measurement in this web stream (see workflow).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-QBCYPGN6SB
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_GUIDE_PRICE_ID=
STRIPE_ITINERARY_PRICE_ID=

# Keep disabled until editorial review and checkout QA are complete.
CONTENT_REVIEWED=false

# Server-side Amap Web Service key. Never use NEXT_PUBLIC_ or commit a real key.
# Retained services ONLY: weatherInfo and transit/integrated.
# The legacy AMAMP_API_KEY spelling is also supported.
AMAP_WEB_SERVICE_KEY=

# Plan a Trip: pay-as-you-go Model Studio key and matching workspace URL.
# Every new plan and revision uses Qwen Plus forced web search, then Qwen JSON planning.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.6-plus
QWEN_SEARCH_MODEL=qwen-plus

# Google Maps browser key: enable Maps JavaScript API and restrict websites/APIs.
# Local preview referrer: http://localhost:3001/*
# Browser keys are public; only use a website-restricted key here.
# Planner has a clear error/retry state if Google Maps is unavailable.
# Restart dev/rebuild after changing.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Separate server credential; NEVER prefix it with NEXT_PUBLIC_.
# Enable Places API (New), Routes API and Maps Static API.
# Restrict to the server IP / these APIs. Do not remove browser-key restrictions.
GOOGLE_MAPS_SERVER_API_KEY=
# Travel Stories: enable YouTube Data API v3. Separate server key, never NEXT_PUBLIC_.
# Restrict to YouTube Data API v3 and the server's public egress IP where available.
YOUTUBE_DATA_API_KEY=
# Accounts, saved trips and guide requests use Supabase + per-user row level security.
NEXT_PUBLIC_SUPABASE_URL=https://hhjalaigivnepmtmoixs.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Do not expose a secret/service_role key. Runtime uses the signed-in user's session.
